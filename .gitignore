# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/
.jekyll-cache/
.bundle/
vendor/bundle/

# Python caches
__pycache__/
*.pyc
*.pyo

# OS metadata and shortcuts
.DS_Store
Thumbs.db
Desktop.ini
*.lnk
*:Zone.Identifier

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# Local development files and private profile materials
local/

# Ignore files created by npm
node_modules
package-lock.json
